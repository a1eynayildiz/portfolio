@{
    // Sayfa başlığı _Layout içinde varsayılan olarak "Aleyna Yıldız – Back-End Geliştirici | Portfolyo" olur.
    var projects = PortfolioData.Projects;
}

<partial name="Sections/_Hero" />
<partial name="Sections/_About" />
<partial name="Sections/_Projects" model="projects" />
<partial name="Sections/_Experience" model="PortfolioData.Experiences" />
<partial name="Sections/_Achievements" model="PortfolioData.Achievements" />
<partial name="Sections/_Contact" />

@foreach (var project in projects)
{
    <partial name="Sections/_ProjectDialog" model="project" />
}
