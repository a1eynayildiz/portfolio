@model List<Experience>

<section id="deneyim" class="section" aria-labelledby="deneyim-baslik">
    <div class="container">
        <div class="section-head">
            <h2 id="deneyim-baslik" class="section-title">Staj deneyimlerim</h2>
            <p class="section-lead">En yeniden en eskiye.</p>
        </div>

        <ol class="route-list">
            @foreach (var exp in Model)
            {
                <li class="stop">
                    <div class="stop-when">
                        <span class="stop-year" aria-hidden="true">@exp.Year</span>
                        <span class="stop-period">@exp.Period</span>
                        @if (!string.IsNullOrWhiteSpace(exp.Kind))
                        {
                            <span class="stop-kind">@exp.Kind</span>
                        }
                    </div>
                    <span class="stop-marker" aria-hidden="true"></span>
                    <article class="stop-body">
                        <h3>
                            <span class="stop-company">
                                @if (!string.IsNullOrWhiteSpace(exp.CompanyUrl))
                                {
                                    <a href="@exp.CompanyUrl" target="_blank" rel="noopener noreferrer">@exp.Company</a>
                                }
                                else
                                {
                                    @exp.Company
                                }
                            </span>
                            <span class="stop-role">@exp.Role</span>
                        </h3>
                        @if (!string.IsNullOrWhiteSpace(exp.Context))
                        {
                            <p class="stop-context">@exp.Context</p>
                        }
                        <ul class="detail-list">
                            @foreach (var h in exp.Highlights)
                            {
                                <li>@h</li>
                            }
                        </ul>
                        @if (exp.Skills.Count > 0)
                        {
                            <p class="stop-skills"><span>Kazanımlar:</span> @string.Join(", ", exp.Skills)</p>
                        }
                    </article>
                </li>
            }
        </ol>
    </div>
</section>
