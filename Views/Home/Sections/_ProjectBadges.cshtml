@model Project
@if (!string.IsNullOrWhiteSpace(Model.Type) || !string.IsNullOrWhiteSpace(Model.Status) || Model.Featured)
{
    <div class="badges">
        @if (Model.Featured)
        {
            <span class="badge badge-accent">Öne Çıkan</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Type))
        {
            <span class="badge">@Model.Type</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Status))
        {
            <span class="badge @(Model.Status == "Canlı" ? "badge-success" : "")">@Model.Status</span>
        }
    </div>
}
