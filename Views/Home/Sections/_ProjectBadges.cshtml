@model Project
@if (!string.IsNullOrWhiteSpace(Model.Type) || !string.IsNullOrWhiteSpace(Model.Status))
{
    <p class="badges">
        @if (!string.IsNullOrWhiteSpace(Model.Type))
        {
            <span class="badge">@Model.Type</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Status))
        {
            <span class="badge @(Model.Status == "Canlı" ? "badge-live" : "")">@Model.Status</span>
        }
    </p>
}
