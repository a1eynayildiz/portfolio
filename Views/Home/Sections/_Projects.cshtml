@model List<Project>

<section id="projeler" class="section" aria-labelledby="projeler-baslik">
    <div class="container">
        <div class="section-head">
            <h2 id="projeler-baslik" class="section-title">Projelerim</h2>
            <p class="section-lead">Ayrıntıları ve proje bağlantısını görmek için bir projeye tıklayın.</p>
        </div>

        <ul class="project-list">
            @foreach (var p in Model)
            {
                <li class="project @(p.Featured ? "is-featured" : "")">
                    <div class="project-cover">
                        <img src="@p.CoverImage" alt="@p.CoverAlt" width="1600" height="900" loading="lazy" decoding="async" />
                    </div>
                    <div class="project-text">
                        <partial name="Sections/_ProjectBadges" model="p" />
                        <h3>
                            @* Bağlantı, CSS ile satırın tamamını tıklanabilir yapar. *@
                            <a href="#projeler/@p.Slug" class="project-open" data-project-open="@p.Slug" aria-haspopup="dialog">@p.Name</a>
                        </h3>
                        <p class="project-tagline">@p.Tagline</p>
                        <p class="project-summary">@p.Summary</p>
                        <p class="project-tech"><span class="visually-hidden">Kullanılan teknolojiler: </span>@string.Join(", ", p.Tech)</p>
                        <span class="project-more" aria-hidden="true">Ayrıntıları gör</span>
                    </div>
                </li>
            }
        </ul>

        <p class="more-on-github">
            Diğer depolarım GitHub'da:
            <a href="@PortfolioData.Github" target="_blank" rel="noopener noreferrer">github.com/a1eynayildiz @Icons.Get("arrow-up-right", 16)</a>
        </p>
    </div>
</section>
